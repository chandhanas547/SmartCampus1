{
  "name": "labflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "db": "node scripts/database.js",
    "admin": "node --env-file-if-exists=server/.env scripts/admin.js",
    "seed:demo": "node --env-file-if-exists=server/.env scripts/seed-demo.js",
    "dev:server": "node --env-file-if-exists=server/.env --watch server/src/index.js",
    "dev:client": "npm run dev --workspace client",
    "start": "node --env-file-if-exists=server/.env server/src/index.js",
    "build": "npm run build --workspace client",
    "test": "node --test server/test/*.test.js && node --test --test-isolation=none client/src/*.test.js",
    "test:integration": "node scripts/prepare-test-db.js && node --test server/test/integration/*.test.js",
    "test:coverage": "node scripts/prepare-test-db.js && node --test --experimental-test-coverage --test-coverage-include='server/src/domain/**' --test-coverage-include='server/src/identity/**' --test-coverage-include='server/src/errors.js' --test-coverage-lines=80 --test-coverage-branches=80 server/test/*.test.js server/test/integration/*.test.js",
    "measure:local": "node scripts/measure-local.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run test:integration && npm run build",
    "test:cloud": "node --env-file=.local/cloud/acceptance.env scripts/verify-cloud.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "mongodb-memory-server-core": "11.3.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.34",
      "distro": "ubuntu-22.04",
      "downloadDir": "./.local/mongodb-binaries"
    }
  }
}
